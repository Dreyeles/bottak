# ==========================================
# CONFIGURACIÓN DE APIS PARA EL BOT DE ROL
# ==========================================

# 1. GROQ (Recomendado como Principal: 14,400 mensajes gratis al día)
# Consigue tu clave gratis en: https://console.groq.com/keys
GROQ_API_KEY=

# 2. OPENROUTER (Recomendado como Respaldo: modelos gratuitos ilimitados)
# Consigue tu clave gratis en: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. VENICE AI (Opcional: si tienes cuenta o saldo en Venice)
# Consigue tu clave en: https://venice.ai/settings/api
VENICE_API_KEY=

# 4. TELEGRAM BOT (Consigue tu token hablando con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=

